/*
 * GYROSCOPE CALIBRATION TOOL
 * 
 * Hardware:
 * - Arduino Nano R3 (or any Arduino)
 * - MPU6050 Gyroscope (GY-521)
 * 
 * Conne
 
 ctions:
 * - VCC -> 5V
 * - GND -> GND
 * - SCL -> A5 (Uno/Nano) or SCL pin
 * - SDA -> A4 (Uno/Nano) or SDA pin
 * 
 * Outputs accelerometer & gyroscope readings every 2 seconds
 * for calibration purposes.
 */

#include <Wire.h>

#define MPU6050_ADDR 0x68

// Calibration offsets (adjust these based on your readings)
int16_t accelOffsetX = 0, accelOffsetY = 0, accelOffsetZ = 0;
int16_t gyroOffsetX = 0, gyroOffsetY = 0, gyroOffsetZ = 0;

// Raw sensor values
int16_t accelX, accelY, accelZ;
int16_t gyroX, gyroY, gyroZ;
int16_t temperature;

// Calibrated values
float calibAccelX, calibAccelY, calibAccelZ;
float calibGyroX, calibGyroY, calibGyroZ;

// Calculated angles
float roll, pitch, yaw;
unsigned long lastUpdate = 0;

void setup() {
  Serial.begin(9600);
  while (!Serial) { ; } // Wait for serial port to connect
  
  Serial.println("========================================");
  Serial.println("   GYROSCOPE CALIBRATION TOOL");
  Serial.println("========================================");
  Serial.println();
  
  // Initialize I2C
  Wire.begin();
  
  // Initialize MPU6050
  if (!initMPU6050()) {
    Serial.println("ERROR: MPU6050 not found!");
    Serial.println("Check connections and try again.");
    while (1) { delay(1000); }
  }
  
  Serial.println("MPU6050 initialized successfully!");
  Serial.println();
  Serial.println("Place the device on a FLAT, STABLE surface");
  Serial.println("and keep it STILL for calibration...");
  Serial.println();
  
  delay(3000);
  
  // Perform calibration
  calibrateSensor();
  
  Serial.println();
  Serial.println("Calibration complete!");
  Serial.println("Reading sensor data every 2 seconds...");
  Serial.println();
  Serial.println("Format: AX, AY, AZ (Accel) | GX, GY, GZ (Gyro) | Roll, Pitch | Temp");
  Serial.println("Units: m/s^2 | deg/s | degrees | Celsius");
  Serial.println("========================================");
}

void loop() {
  unsigned long currentMillis = millis();
  
  // Output every 2 seconds
  if (currentMillis - lastUpdate >= 2000) {
    lastUpdate = currentMillis;
    
    readSensorData();
    applyCalibration();
    calculateAngles();
    printData();
  }
}

bool initMPU6050() {
  Wire.beginTransmission(MPU6050_ADDR);
  Wire.write(0x6B); // Power management register
  Wire.write(0);    // Wake up MPU6050
  if (Wire.endTransmission(true) != 0) {
    return false;
  }
  
  // Configure accelerometer range (+/- 2g)
  Wire.beginTransmission(MPU6050_ADDR);
  Wire.write(0x1C); // ACCEL_CONFIG register
  Wire.write(0);    // +/- 2g range
  Wire.endTransmission(true);
  
  // Configure gyroscope range (+/- 250 deg/s)
  Wire.beginTransmission(MPU6050_ADDR);
  Wire.write(0x1B); // GYRO_CONFIG register
  Wire.write(0);    // +/- 250 deg/s range
  Wire.endTransmission(true);
  
  return true;
}

void calibrateSensor() {
  Serial.println("Calibrating... Keep device still!");
  
  long sumAccelX = 0, sumAccelY = 0, sumAccelZ = 0;
  long sumGyroX = 0, sumGyroY = 0, sumGyroZ = 0;
  int samples = 200;
  
  for (int i = 0; i < samples; i++) {
    readSensorData();
    
    sumAccelX += accelX;
    sumAccelY += accelY;
    sumAccelZ += accelZ;
    sumGyroX += gyroX;
    sumGyroY += gyroY;
    sumGyroZ += gyroZ;
    
    delay(5);
  }
  
  // Calculate average offsets
  accelOffsetX = sumAccelX / samples;
  accelOffsetY = sumAccelY / samples;
  accelOffsetZ = (sumAccelZ / samples) - 16384; // Subtract 1g for Z axis (gravity)
  gyroOffsetX = sumGyroX / samples;
  gyroOffsetY = sumGyroY / samples;
  gyroOffsetZ = sumGyroZ / samples;
  
  Serial.println("Calibration offsets calculated:");
  Serial.print("  Accel X: "); Serial.println(accelOffsetX);
  Serial.print("  Accel Y: "); Serial.println(accelOffsetY);
  Serial.print("  Accel Z: "); Serial.println(accelOffsetZ);
  Serial.print("  Gyro X:  "); Serial.println(gyroOffsetX);
  Serial.print("  Gyro Y:  "); Serial.println(gyroOffsetY);
  Serial.print("  Gyro Z:  "); Serial.println(gyroOffsetZ);
}

void readSensorData() {
  Wire.beginTransmission(MPU6050_ADDR);
  Wire.write(0x3B); // Starting register for accelerometer
  Wire.endTransmission(false);
  Wire.requestFrom(MPU6050_ADDR, 14, true); // Request 14 bytes
  
  // Read accelerometer (6 bytes)
  accelX = (Wire.read() << 8) | Wire.read();
  accelY = (Wire.read() << 8) | Wire.read();
  accelZ = (Wire.read() << 8) | Wire.read();
  
  // Read temperature (2 bytes)
  temperature = (Wire.read() << 8) | Wire.read();
  
  // Read gyroscope (6 bytes)
  gyroX = (Wire.read() << 8) | Wire.read();
  gyroY = (Wire.read() << 8) | Wire.read();
  gyroZ = (Wire.read() << 8) | Wire.read();
}

void applyCalibration() {
  // Apply offsets and convert to physical units
  calibAccelX = (accelX - accelOffsetX) / 16384.0 * 9.81; // m/s^2
  calibAccelY = (accelY - accelOffsetY) / 16384.0 * 9.81; // m/s^2
  calibAccelZ = (accelZ - accelOffsetZ) / 16384.0 * 9.81; // m/s^2
  
  calibGyroX = (gyroX - gyroOffsetX) / 131.0; // deg/s
  calibGyroY = (gyroY - gyroOffsetY) / 131.0; // deg/s
  calibGyroZ = (gyroZ - gyroOffsetZ) / 131.0; // deg/s
}

void calculateAngles() {
  // Calculate Roll and Pitch from accelerometer
  roll = atan2(calibAccelY, calibAccelZ) * 180.0 / PI;
  pitch = atan2(-calibAccelX, sqrt(calibAccelY * calibAccelY + calibAccelZ * calibAccelZ)) * 180.0 / PI;
  
  // Normalize roll to 0-360
  if (roll < 0) roll += 360;
}

void printData() {
  // Temperature in Celsius
  float tempC = (temperature / 340.0) + 36.53;
  
  Serial.println("----------------------------------------");
  Serial.print("ACCEL (m/s^2)  | X: ");
  Serial.print(calibAccelX, 2);
  Serial.print("  Y: ");
  Serial.print(calibAccelY, 2);
  Serial.print("  Z: ");
  Serial.println(calibAccelZ, 2);
  
  Serial.print("GYRO (deg/s)   | X: ");
  Serial.print(calibGyroX, 2);
  Serial.print("  Y: ");
  Serial.print(calibGyroY, 2);
  Serial.print("  Z: ");
  Serial.println(calibGyroZ, 2);
  
  Serial.print("ANGLES (deg)   | Roll: ");
  Serial.print(roll, 1);
  Serial.print("  Pitch: ");
  Serial.println(pitch, 1);
  
  Serial.print("TEMP (C)       | ");
  Serial.println(tempC, 1);
  
  // Orientation indicator
  Serial.print("ORIENTATION    | ");
  if (roll >= 30 && roll < 150) {
    Serial.println("UPRIGHT (0 deg)");
  } else if (roll >= 150 && roll < 210) {
    Serial.println("RIGHT (90 deg)");
  } else if (roll >= 210 && roll < 330) {
    Serial.println("UPSIDE DOWN (180 deg)");
  } else {
    Serial.println("LEFT (270 deg)");
  }
}
